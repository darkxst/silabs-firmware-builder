project_name: openthread_ftd
label: OpenThread - SoC CLI (FTD)
package: OpenThread
description:   >
  This is a simple CLI application for a Full Thread Device. This is equivalent
  to the ot-cli-ftd application in the OpenThread GitHub repo. Unlike the RCP,
  the full Thread stack runs on-chip, so the device joins a mesh and routes
  without a host.
category: OpenThread Examples
quality: production

component:
  - id: ot_stack_ftd
  - id: ot_cli_source
  - id: ot_crash_handler
  - id: uartdrv_usart
    instance:
      - vcom
  - id: rail_util_pti
  - id: bootloader_interface
  - id: clock_manager

include:
  - path: .
    file_list:
    - path: app.h
    - path: reset_util.h  # Originally included from `util/third_party/openthread/src/lib/platform`

source:
  - path: main.c
  - path: app.c

define:
  - name: OPENTHREAD_CONFIG_DEFAULT_TRANSMIT_POWER
    value: 6

configuration:
  - name: SL_BOARD_ENABLE_VCOM
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
    value: 1
  - name: SL_MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
    value: 1
  - name: SL_STACK_SIZE
    value: 5120
  - name: OPENTHREAD_CONFIG_HEAP_EXTERNAL_ENABLE
    value: 0
  - name: CIRCULAR_QUEUE_LEN_MAX
    value: 16
  # The SDK's ot-cli-ftd.slcp defaults these to uartdrvFlowControlHwUart, which
  # wedges the CLI on boards that do not bring out CTS/RTS. Manifests for
  # boards that do have flow control can override it.
  #
  # Conditioned on the driver actually in use, so a manifest can swap
  # uartdrv_usart for uartdrv_eusart without touching this project.
  - name: SL_UARTDRV_USART_VCOM_FLOW_CONTROL_TYPE
    value: uartdrvFlowControlNone
    condition: [uartdrv_usart]
  - name: SL_UARTDRV_EUSART_VCOM_FLOW_CONTROL_TYPE
    value: uartdrvFlowControlNone
    condition: [uartdrv_eusart]

filter:
  - name: "Wireless Technology"
    value: ["Thread"]
  - name: "Device Type"
    value: ["SoC"]
  - name: "Project Difficulty"
    value: ["Beginner"]
